{
  "expo": {
    "name": "BTC Live Analyzer",
    "slug": "btc-live-analyzer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "btc-live-analyzer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.btcliveanalyzer.app",
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "permissions": [
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "ec5907a8-5def-40a7-bf1a-532bd17345fe"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router", "./plugins/with-startup-diagnostics.cjs"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
